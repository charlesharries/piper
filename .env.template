# Server configuration
SERVER_PORT=8080
SERVER_HOST=localhost

SERVER_ROOT_URL=

# Enable music services
ENABLE_SPOTIFY=true
ENABLE_LASTFM=true
ENABLE_APPLEMUSIC=true

# Spotify OAuth configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_SCOPES=user-read-currently-playing user-read-email

# ATProto OAuth configuration
# link to metadata url
ATPROTO_CLIENT_ID=
ATPROTO_METADATA_URL=
ATPROTO_CALLBACK_URL=
ATPROTO_CLIENT_SECRET_KEY={goat key generate -t P-256}
ATPROTO_CLIENT_SECRET_KEY_ID={can be whatever usually a timestamp}

# Last.fm
LASTFM_API_KEY=

# ListenBrainz. Optional: enables ListenBrainz lookups, which resolve plays to
# MusicBrainz ids more reliably than searching MusicBrainz directly. Without a
# token piper falls back to search.
LISTENBRAINZ_TOKEN=

# How piper identifies itself, in submitted plays and to MusicBrainz and
# ListenBrainz. Optional; defaults to this build's own version.
SUBMISSION_AGENT=

# Callback URLs
CALLBACK_SPOTIFY=

# Tracker settings
TRACKER_INTERVAL=30

# Database settings
DB_PATH=./piper.db

# Allowed DIDs
ALLOWED_DIDS=

# How much MusicBrainz matching logs: debug, info, warn or error. Optional;
# defaults to info. debug adds search cache hits and request retries, which is
# what to turn on when working out why a play matched the wrong recording.
LOG_LEVEL=
